{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lolosremote-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "lolosremote-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "NEXT_DIST_DIR=.next-preview exec npx next dev"
      ],
      "port": 3100,
      "autoPort": true
    }
  ]
}
